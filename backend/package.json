{
  "name": "resume-builder-backend",
  "version": "1.0.0",
  "description": "Backend API for the Reverse ATS / Dynamic Resume Builder",
  "main": "dist/lambda.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; npm run build",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "5.2.1",
    "express-rate-limit": "7.4.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.12.1",
    "pg": "8.13.1",
    "serverless-http": "^4.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.13",
    "typescript": "5.6.3"
  }
}
